# ==============================================================================
# KINKEEP PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting development: cp .env.example .env
# NEVER commit .env to source control!
# ==============================================================================

# PLATFORM ENVIRONMENT
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=kinkeep_dev_secret_key_change_in_production_min_50_chars_long_xyz
ALLOWED_HOSTS=localhost,127.0.0.1,web,api
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# POSTGRESQL DATABASE
DB_NAME=kinkeep_db
DB_USER=kinkeep_admin
DB_PASSWORD=kinkeep_secure_dev_password_2026
DB_HOST=localhost
DB_PORT=5432

# REDIS & CELERY
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# MINIO / S3 PRIVATE OBJECT STORAGE
STORAGE_TYPE=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ROOT_USER=kinkeep_minio_admin
MINIO_ROOT_PASSWORD=kinkeep_minio_dev_password_2026
MINIO_BUCKET_NAME=kinkeep-private-media
AWS_STORAGE_BUCKET_NAME=kinkeep-private-media

# JWT AUTHENTICATION
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256

# CORS CONFIGURATION
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# EMAIL SETTINGS (Console backend in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=KinKeep <no-reply@kinkeep.com>
